# API Keys
VITE_NEWS_API_KEY=your_news_api_key
VITE_NEWSDATA_API_KEY=your_newsdata_key
VITE_FINNHUB_API_KEY=your_finnhub_key

# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role (Apenas para scripts de administração e migrações)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key

# PostgreSQL Direct Connection (Opcional, apenas para acesso direto)
POSTGRES_HOST=your_postgres_host
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=postgres

# Other Configuration
VITE_API_BASE_URL=http://localhost:8080

# Instruções:
# 1. Copie este arquivo para .env
# 2. Substitua os valores das variáveis pelos seus valores reais
# 3. Obtenha as chaves de API em:
#    - News API: https://newsapi.org/register
#    - NewsData API: https://newsdata.io/register
#    - Finnhub: https://finnhub.io/register
# 4. Configure seu projeto Supabase e obtenha as credenciais em:
#    https://supabase.com/dashboard
#    - ANON_KEY: chave pública para uso no frontend
#    - SERVICE_KEY: chave de serviço para acesso administrativo (mantenha segura!) 