# Ativar o mecanismo de reescrita
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Redirecionar todas as solicitações para o index.html (para SPA)
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Definir cabeçalhos HTTP corretos
<IfModule mod_headers.c>
    # Segurança
    Header set X-Content-Type-Options "nosniff"
    
    # Remover cabeçalhos obsoletos
    Header unset X-XSS-Protection
    Header unset Pragma
    Header unset Expires
    
    # Cache para arquivos estáticos (1 ano)
    <FilesMatch "\.(css|js|ico|gif|jpg|jpeg|png|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>
    
    # Cache para HTML (sem cache)
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# Compressão GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml
</IfModule> 